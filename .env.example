# Copia este archivo como .env.local y completa los valores.

# Token público de Mapbox (https://account.mapbox.com/access-tokens/). Sin él, la app muestra un aviso en lugar del mapa.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Opcional: otro estilo de Mapbox Studio. Si se deja vacío, se usa el estilo del equipo.
NEXT_PUBLIC_MAPBOX_STYLE=

# true (o vacío) = usa datos de prueba para clima y otras pantallas aún sin API.
NEXT_PUBLIC_USE_MOCKS=true

# El contexto y las recomendaciones usan el modelo real por defecto.
# Poner true solo para una demostración completamente basada en mocks.
NEXT_PUBLIC_USE_MOCKS_MODELO=false

# Dejar vacío si Next.js sirve el backend en el mismo origen.
NEXT_PUBLIC_API_URL=
