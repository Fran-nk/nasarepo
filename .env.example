# Copia este archivo como .env.local y completa los valores.

# Token público de Mapbox (https://account.mapbox.com/access-tokens/). Sin él, la app muestra un aviso en lugar del mapa.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Opcional: otro estilo de Mapbox Studio. Si se deja vacío, se usa el estilo del equipo.
NEXT_PUBLIC_MAPBOX_STYLE=

# Los datos del clima no necesitan clave: salen de NASA POWER y Open-Meteo (ver docs/fuentes-de-datos.md).
# Ya no hay datos de prueba: todo sale de fuentes reales.

# Dejar vacío si Next.js sirve el backend (recomendaciones con el modelo y catálogo de semillas) en el mismo origen.
NEXT_PUBLIC_API_URL=
